{
  "tasks": [
    {
      "args": [
        "build",
        "${workspaceFolder}/Autofac.Multitenant.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "command": "dotnet",
      "group": {
        "isDefault": true,
        "kind": "build"
      },
      "label": "build",
      "problemMatcher": "$msCompile",
      "type": "shell"
    },
    {
      "args": [
        "test",
        "${workspaceFolder}/Autofac.Multitenant.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "--results-directory",
        "\"artifacts/coverage\"",
        "--logger:trx",
        "--collect:\"XPlat Code Coverage\"",
        "--settings:build/Coverage.runsettings"
      ],
      "command": "dotnet",
      "group": {
        "isDefault": true,
        "kind": "test"
      },
      "label": "test",
      "problemMatcher": "$msCompile",
      "type": "process"
    }
  ],
  "version": "2.0.0"
}
